      "name": "1. Obtener todas las experiencias (GET)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/experiencias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "experiencias"
          ]
        },
        "description": "Obtiene la lista completa de todas las experiencias laborales registradas en MongoDB."
      },
      "response": []
    },
    {
      "name": "2. Crear una nueva experiencia (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.success && jsonData.data && jsonData.data._id) {",
              "    pm.collectionVariables.set('experienciaId', jsonData.data._id);",
              "    console.log('ID guardado para siguientes pruebas:', jsonData.data._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cargo\": \"Consultor en Gestión de Mercados y Proyectos\",\n  \"empresa\": \"Consultores Asociados del Caribe\",\n  \"periodo\": \"Ene 2026 - Presente\",\n  \"ubicacion\": \"Montería, Córdoba\",\n  \"tipoEntidad\": \"Entidad Privada\",\n  \"descripcion\": \"Asesoría estratégica en formulación de planes de marketing y estructuración de proyectos formativos.\",\n  \"orden\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/experiencias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "experiencias"
          ]
        },
        "description": "Registra una nueva experiencia profesional en MongoDB. Guarda automáticamente el `_id` creado en la variable de colección `experienciaId`."
      },
      "response": []
    },
    {
      "name": "3. Obtener una experiencia por ID (GET)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/experiencias/{{experienciaId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "experiencias",
            "{{experienciaId}}"
          ]
        },
        "description": "Busca y retorna el detalle de una experiencia laboral específica usando su ObjectId de MongoDB."
      },
      "response": []
    },
    {
      "name": "4. Actualizar una experiencia por ID (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
