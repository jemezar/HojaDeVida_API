            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cargo\": \"Director de Proyectos y Gestión de Mercados\",\n  \"empresa\": \"Consultores Asociados del Caribe\",\n  \"periodo\": \"Ene 2026 - Dic 2026\",\n  \"ubicacion\": \"Montería, Córdoba\",\n  \"tipoEntidad\": \"Entidad Privada\",\n  \"descripcion\": \"Liderazgo integral en formulación, evaluación y ejecución de proyectos comerciales.\",\n  \"orden\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/experiencias/{{experienciaId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "experiencias",
            "{{experienciaId}}"
          ]
        },
        "description": "Actualiza la información de una experiencia laboral existente en MongoDB."
      },
      "response": []
    },
    {
      "name": "5. Eliminar una experiencia por ID (DELETE)",
      "request": {
        "method": "DELETE",
        "header": [
          {
